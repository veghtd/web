<script>
function kuld() {
  let nev = document.getElementById("nev").value;
  let kor = Number(document.getElementById("kor").value);
  let nemGomb = document.querySelector("input[name='nem']:checked");
  let hirlevel = document.getElementById("hirlevel").checked;
  let varos = document.getElementById("varos").value;

  // checks first
