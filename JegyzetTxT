  <label>Név: <input type="text" id="nev"></label><br>
  <label>Kor: <input type="number" id="kor" value="18"></label><br>

  Nem:
  <label><input type="radio" name="nem" value="Férfi"> Férfi</label>
  <label><input type="radio" name="nem" value="Nő"> Nő</label><br>

  <label><input type="checkbox" id="hirlevel"> Kérek hírlevelet</label><br>

