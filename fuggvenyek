## 17. Exam-style examples

### a) Is it even?

```js
function parosE(szam) {
  return szam % 2 == 0;      // gives true or false
}

if (parosE(8)) alert("páros");
```

### b) Bigger of two numbers

```js
function nagyobb(a, b) {
  if (a > b) {
    return a;
  } else {
    return b;
  }
}
alert(nagyobb(3, 7));   // 7
```

### c) Random number between min and max

```js
function veletlen(min, max) {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}
let titok = veletlen(1, 100);
```

### d) Sum from 1 to n (loop inside a function)

```js
function osszeg(n) {
  let s = 0;
  for (let i = 1; i <= n; i++) {
    s = s + i;
  }
  return s;
}
alert(osszeg(10));   // 55
```

### e) Factorial

```js
function faktorialis(n) {
  let f = 1;
  for (let i = 2; i <= n; i++) {
    f = f * i;
  }
  return f;
}
alert(faktorialis(5));   // 120
```

### f) Is it a prime number?

```js
function primE(n) {
  if (n < 2) return false;
  for (let i = 2; i < n; i++) {
    if (n % i == 0) return false;   // found a divisor -> stop, not prime
  }
  return true;                      // no divisor found
}
```

### g) Area of a rectangle, read from inputs, button click

```html
a: <input type="number" id="a">
b: <input type="number" id="b">
<button onclick="szamol()">Számol</button>
<p id="ki"></p>

<script>
function terulet(a, b) {             // pure math, no HTML
  return a * b;
}

function szamol() {                  // the button handler: read -> compute -> write
  let a = Number(document.getElementById("a").value);
  let b = Number(document.getElementById("b").value);

  if (a <= 0 || b <= 0) {
    document.getElementById("ki").innerHTML = "Pozitív számokat adj meg!";
    return;
  }

  document.getElementById("ki").innerHTML = "Terület: " + terulet(a, b);
}
</script>
```

> 💡 Good structure: **one function for the math** (takes parameters, returns a value) + **one function for the button** (reads inputs, calls the math function, writes the result).

### h) Celsius → Fahrenheit, three ways

```js
function cToF(c) { return c * 9 / 5 + 32; }          // declaration
const cToF2 = function (c) { return c * 9 / 5 + 32; }; // expression
const cToF3 = c => c * 9 / 5 + 32;                    // arrow

alert(cToF(100));   // 212
```

### i) Counter with a global variable

```html
<button onclick="novel()">+1</button>
<button onclick="nullaz()">Nulláz</button>
<p id="ki">0</p>

<script>
let szamlalo = 0;                    // global, both functions use it

function novel() {
  szamlalo++;
  document.getElementById("ki").innerHTML = szamlalo;
}

function nullaz() {
  szamlalo = 0;
  document.getElementById("ki").innerHTML = szamlalo;
}
</script>
```

