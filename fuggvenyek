## 5. return – giving back a value

`alert` only **shows** a result. `return` **gives the result back** to whoever called the function, so you can store it and use it.

```js
function osszead(a, b) {
  return a + b;
}

let eredmeny = osszead(2, 3);    // eredmeny = 5
alert(eredmeny);                 // 5
alert(osszead(10, 20) * 2);      // 60 -> you can use the call like a number
```

> **In plain words:** `osszead(2, 3)` gets **replaced by** whatever the function returns. It's as if you had written `5` there.

### Example from the currency exchange

```js
function arfolyam(penznem) {
  if (penznem == "EUR") return 363.6;
  if (penznem == "USD") return 323.1;
  return 1;                         // HUF
}

let ft = 100 * arfolyam("EUR");     // 100 * 363.6 = 36360
```

### Without return you get `undefined`

```js
function rossz(a, b) {
  a + b;                // calculated, but NOT returned
}
let x = rossz(2, 3);    // x = undefined  ❌
```

### Rules of return
- A function can **return only ONE value**. To give back several, use an array or object: `return [a, b];`
- After `return` the function **stops immediately**. The code below it does not run.

```js
function teszt() {
  return 1;
  alert("this NEVER runs");
}
```

